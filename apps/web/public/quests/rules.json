      "isPurchasable": "boolean",
      "coinCost": "number",
      "isUnlockable": "boolean",
      "isQuestPickup": "boolean",
      "canBeUsedInDecisions": "boolean",
      "usageTags": ["cleaning", "repair", "navigation", "social", "magic", "light", "food", "safety"]
    }
  },
  "decisionRules": {
    "allowItemPickupChoices": true,
    "itemPickupChoicesAddToInventory": true,
    "allowRequiredItemChoices": true,
    "allowOptionalItemChoices": true,
    "allowNoItemChoices": true,
    "mostChoicesShouldNotRequireItems": true,
    "moralChoiceTags": [
      "honest",
      "helpful",
      "brave",
      "kind",
      "patient",
      "responsible",
      "selfish",
      "dishonest",
      "unsafe",
      "harmful",
      "greedy"
    ]
  },
  "difficultyScoring": {
