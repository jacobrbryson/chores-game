{
  "version": "1.0.0",
  "questRules": {
    "durationMinutes": { "min": 3, "max": 15 },
    "pageRules": {
      "sentencesPerPage": { "min": 3, "max": 12 },
      "decisionSpacingPages": { "min": 3, "max": 9 }
    },
    "purchaseRules": {
      "questsAreCoinSinks": true,
      "mostDecisionPathsRequireNoPurchase": true,
      "maxRequiredStoreItemsPerDecision": 1,
      "avoidRequiredPurchasesOnMostPaths": true
    },
    "endingRules": {
      "encouragePrematureEndings": true,
      "badMoralChoicesEndEarly": true,
      "badMoralChoiceExamples": [
        "lying",
        "cheating",
        "stealing",
        "hurting others",
        "bullying",
        "being unsafe"
      ],
      "endingTypes": [
        "success",
        "partial_success",
        "moral_failure",
        "silly_failure",
        "unsafe_choice",
        "secret_ending",
        "true_ending"
      ]
    },
    "replayRules": {
      "trackDiscoveredEndings": true,
      "trackCompletionPercent": true,
      "preventRewardFarming": true
    }
  },
  "inventoryRules": {
    "itemsCarryAcrossQuests": true,
    "itemsAreReusable": true,
    "itemsAreNeverConsumed": true,
    "allowFreeQuestPickups": true,
    "itemTypes": ["store_item", "quest_item", "unlockable_item"]
  },
  "rewardRules": {
