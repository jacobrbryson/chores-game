      "optionalItemCoinValue": 0.02,
      "moralComplexity": 2,
      "replayComplexity": 2
    },
    "ranks": [
      { "rank": 1, "label": "Tiny Quest", "scoreMin": 0, "scoreMax": 15 },
      { "rank": 2, "label": "Short Quest", "scoreMin": 16, "scoreMax": 30 },
      { "rank": 3, "label": "Adventure Quest", "scoreMin": 31, "scoreMax": 50 },
      { "rank": 4, "label": "Hero Quest", "scoreMin": 51, "scoreMax": 75 },
      { "rank": 5, "label": "Legend Quest", "scoreMin": 76, "scoreMax": 999 }
    ]
  },
  "contentRules": {
    "supportTargetAgeGroups": true,
    "scaleSentenceCountByAge": true,
    "avoidShameLanguage": true,
    "avoidOverlyScaryContent": true,
    "badChoicesShouldTeachConsequences": true,
    "questShouldHaveClearIntent": true,
