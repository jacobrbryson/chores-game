rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function primaryFamilyIdForUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.familyIds[0];
    }

    function userBelongsToFamily(uid, familyId) {
      let memberDocPath = /databases/$(database)/documents/families/$(familyId)/members/$(uid);
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.familyIds is list
        && get(/databases/$(database)/documents/users/$(uid)).data.familyIds.hasAny([familyId])
        || (
          exists(memberDocPath)
          && get(memberDocPath).data.deleted != true
        );
    }

    function canAdminManageUser(uid) {
      let requesterFamilyId = primaryFamilyIdForUser(request.auth.uid);
      return isSignedIn()
        && requesterFamilyId is string
        && requesterFamilyId != ""
        && isFamilyAdmin(requesterFamilyId)
        && userBelongsToFamily(uid, requesterFamilyId);
    }

    function canAdminBootstrapManagedUser(uid) {
      let requesterFamilyId = primaryFamilyIdForUser(request.auth.uid);
      return isSignedIn()
        && requesterFamilyId is string
        && requesterFamilyId != ""
        && isFamilyAdmin(requesterFamilyId)
        && exists(/databases/$(database)/documents/families/$(requesterFamilyId)/members/$(uid))
        && get(/databases/$(database)/documents/families/$(requesterFamilyId)/members/$(uid)).data.deleted != true
        && (
          get(/databases/$(database)/documents/families/$(requesterFamilyId)/members/$(uid)).data.role == null
          || get(/databases/$(database)/documents/families/$(requesterFamilyId)/members/$(uid)).data.role == "player"
        );
    }

    function memberDocPathByUid(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
    }

    function memberDocPathByEmail(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.token.email.lower());
    }

    function hasUidMemberDoc(familyId) {
      return isSignedIn()
        && exists(memberDocPathByUid(familyId))
        && get(memberDocPathByUid(familyId)).data.deleted != true;
    }

    function hasEmailMemberDoc(familyId) {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email != ""
        && exists(memberDocPathByEmail(familyId))
        && get(memberDocPathByEmail(familyId)).data.deleted != true;
    }

    function hasClaimableEmailInvite(familyId) {
      return hasEmailMemberDoc(familyId)
        && (
          get(memberDocPathByEmail(familyId)).data.status == "invited"
          || get(memberDocPathByEmail(familyId)).data.status == "claimed"
        );
    }

    function hasClaimableUidInvite(familyId) {
      return hasUidMemberDoc(familyId)
        && (
          get(memberDocPathByUid(familyId)).data.status == "invited"
          || get(memberDocPathByUid(familyId)).data.status == "claimed"
        );
    }

    function inviteRoleAllowsClaim(familyId) {
      return get(memberDocPathByEmail(familyId)).data.role == null
        ? request.resource.data.role == "player"
        : request.resource.data.role == get(memberDocPathByEmail(familyId)).data.role;
    }

    function uidInviteRoleAllowsClaim(familyId) {
      return get(memberDocPathByUid(familyId)).data.role == null
        ? request.resource.data.role == "player"
        : request.resource.data.role == get(memberDocPathByUid(familyId)).data.role;
    }

    function uidInviteEmailAllowsClaim(familyId) {
      return get(memberDocPathByUid(familyId)).data.email == null
        || (
          request.resource.data.email is string
          && request.resource.data.email.lower() == get(memberDocPathByUid(familyId)).data.email.lower()
        );
    }

    function isFamilyMember(familyId) {
      return hasUidMemberDoc(familyId) || hasEmailMemberDoc(familyId);
    }

    function isRequesterAssigneeId(assigneeId) {
      return isSignedIn()
        && (
          assigneeId == request.auth.uid
          || (
            request.auth.token.email != null
            && request.auth.token.email != ""
            && assigneeId == request.auth.token.email.lower()
          )
        );
    }

    function requesterMemberIdsForFamily(familyId) {
      let uidMemberId = request.auth.uid;
      let emailMemberId = request.auth.token.email != null && request.auth.token.email != ""
        ? request.auth.token.email.lower()
        : "";
      return [uidMemberId, emailMemberId];
    }

    function isRequesterInAssigneeIds(familyId, assigneeIds) {
      let aliases = requesterMemberIdsForFamily(familyId);
      return assigneeIds is list
        && (
          assigneeIds.hasAny([aliases[0]])
          || (
            aliases[1] != ""
            && assigneeIds.hasAny([aliases[1]])
          )
        );
    }

    function canRequesterCompleteChore(familyId, choreData) {
      return isRequesterAssigneeId(choreData.assigneeId)
        || isRequesterInAssigneeIds(familyId, choreData.assigneeIds)
        || (
          choreData.assigneeScope == "family"
          && isFamilyMember(familyId)
        );
    }

    function canPlayerCreateRecurringSuccessor(familyId) {
      let parentId = request.resource.data.recurrenceParentChoreId;
      let parentPath = /databases/$(database)/documents/families/$(familyId)/chores/$(parentId);
      return isFamilyMember(familyId)
        && request.resource.data.source == "manual"
        && request.resource.data.status == "Open"
        && request.resource.data.deleted == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.assigneeName is string
        && request.resource.data.assigneeId is string
        && isRequesterAssigneeId(request.resource.data.assigneeId)
        && request.resource.data.details is string
        && request.resource.data.categoryIds is list
        && request.resource.data.dueDate is string
        && request.resource.data.coinValue is int
        && request.resource.data.requireApproval is bool
        && request.resource.data.recurrenceType is string
        && request.resource.data.recurrenceInterval is int
        && request.resource.data.recurrenceUnit is string
        && request.resource.data.recurrenceParentChoreId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.sortOrder is int
        && exists(parentPath)
        && get(parentPath).data.deleted != true
        && get(parentPath).data.source == "manual"
        && get(parentPath).data.recurrenceType != "none"
        && get(parentPath).data.assigneeId == request.resource.data.assigneeId
        && get(parentPath).data.title == request.resource.data.title
        && get(parentPath).data.details == request.resource.data.details
        && get(parentPath).data.coinValue == request.resource.data.coinValue
        && get(parentPath).data.requireApproval == request.resource.data.requireApproval
        && get(parentPath).data.recurrenceType == request.resource.data.recurrenceType
        && get(parentPath).data.recurrenceInterval == request.resource.data.recurrenceInterval
        && get(parentPath).data.recurrenceUnit == request.resource.data.recurrenceUnit;
    }

    function isFamilyAdmin(familyId) {
      return (
        hasUidMemberDoc(familyId)
        && get(memberDocPathByUid(familyId)).data.role == "admin"
        && (
          get(memberDocPathByUid(familyId)).data.status == null
          || get(memberDocPathByUid(familyId)).data.status == "active"
        )
      )
        || (
          hasEmailMemberDoc(familyId)
          && get(memberDocPathByEmail(familyId)).data.role == "admin"
          && (
            get(memberDocPathByEmail(familyId)).data.status == null
            || get(memberDocPathByEmail(familyId)).data.status == "active"
          )
        );
    }

    function isFamilyCreatorBootstrap(familyId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/families/$(familyId)).data.createdBy == request.auth.uid;
    }

    function rewardRedeemedCount(data) {
      return data.familyRedeemedCount is int ? data.familyRedeemedCount : 0;
    }

    function canRedeemFamilyReward(familyId) {
      return isFamilyMember(familyId)
        && resource.data.deleted != true
        && resource.data.disabled != true
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["familyRedeemedCount", "updatedAt"])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.familyRedeemedCount is int
        && request.resource.data.familyRedeemedCount == rewardRedeemedCount(resource.data) + 1;
    }

    function canCreateAwardClaim(familyId) {
      let purchaserUid = request.resource.data.purchaserUid;
      let purchaserMemberDocPath = /databases/$(database)/documents/families/$(familyId)/members/$(purchaserUid);
      let purchaserIsFamilyMember = userBelongsToFamily(purchaserUid, familyId)
        || (
          exists(purchaserMemberDocPath)
          && get(purchaserMemberDocPath).data.deleted != true
        );
      return isFamilyMember(familyId)
        && request.resource.data.rewardId is string
        && request.resource.data.rewardDescription is string
        && request.resource.data.rewardImageId is string
        && request.resource.data.coinCost is int
        && purchaserUid is string
        && (
          purchaserUid == request.auth.uid
          || (
            isFamilyAdmin(familyId)
            && purchaserIsFamilyMember
          )
        )
        && request.resource.data.purchaserName is string
        && request.resource.data.purchaserEmail is string
        && request.resource.data.status == "unclaimed"
        && request.resource.data.purchasedAt is timestamp
        && request.resource.data.claimedByUid is string
        && request.resource.data.claimedByName is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function canAdminClaimAward(familyId) {
      return isFamilyAdmin(familyId)
        && resource.data.status == "unclaimed"
        && request.resource.data.status == "claimed"
        && request.resource.data.claimedAt is timestamp
        && request.resource.data.claimedByUid == request.auth.uid
        && request.resource.data.claimedByName is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "status",
          "claimedAt",
          "claimedByUid",
          "claimedByName",
          "updatedAt"
        ]);
    }

    function requestedUserHasPrimaryFamily() {
      return request.resource.data.familyIds is list
        && request.resource.data.familyIds.size() == 1
        && request.resource.data.familyIds[0] is string
        && request.resource.data.familyIds[0] != "";
    }

    function requestedUserPrimaryFamilyId() {
      return request.resource.data.familyIds[0];
    }

    function requestedUserPrimaryFamilyMemberPath(uid) {
      return /databases/$(database)/documents/families/$(requestedUserPrimaryFamilyId())/members/$(uid);
    }

    function requestedUserRoleMatchesMembership(uid) {
      return requestedUserHasPrimaryFamily()
        && exists(requestedUserPrimaryFamilyMemberPath(uid))
        && get(requestedUserPrimaryFamilyMemberPath(uid)).data.deleted != true
        && get(requestedUserPrimaryFamilyMemberPath(uid)).data.status == "active"
        && request.resource.data.role is string
        && request.resource.data.role in ["admin", "player"]
        && request.resource.data.role == get(requestedUserPrimaryFamilyMemberPath(uid)).data.role;
    }

    function isValidSelfUserAuthSync(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.photoUrl is string
        && request.resource.data.provider == "google"
        && request.resource.data.lastSignInAt is timestamp
        && request.resource.data.email is string
        && (
          request.auth.token.email == null
          || request.resource.data.email.lower() == request.auth.token.email.lower()
        )
        && (
          !("familyIds" in request.resource.data)
          ? request.resource.data.role == "player"
          : (
              requestedUserHasPrimaryFamily()
              && request.resource.data.lastFamilyUpdateAt is timestamp
              && requestedUserRoleMatchesMembership(uid)
            )
        );
    }

    function isValidSelfUserCreate(uid) {
      return isSelf(uid)
        && request.resource.data.keys().hasOnly([
          "uid",
          "role",
          "email",
          "displayName",
          "photoUrl",
          "provider",
          "lastSignInAt",
          "familyIds",
          "lastFamilyUpdateAt"
        ])
        && isValidSelfUserAuthSync(uid);
    }

    function isValidSelfUserProfileUpdate(uid) {
      return isSelf(uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "name",
          "displayName",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.displayName is string
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidSelfUserPreferencesUpdate(uid) {
      return isSelf(uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "preferencesMyChoresOnly",
          "preferencesCompletionWindow",
          "preferencesChoreAdvancedOptionsOpenV2",
          "preferencesThemeOptionId",
          "preferencesThemePrimaryColor",
          "preferencesThemeSecondaryColor",
          "preferencesThemeTertiaryColor",
          "preferencesUpdatedAt",
          "storeUpdatedAt"
        ])
        && (
          !("preferencesMyChoresOnly" in request.resource.data)
          || request.resource.data.preferencesMyChoresOnly is bool
        )
        && (
          !("preferencesCompletionWindow" in request.resource.data)
          || request.resource.data.preferencesCompletionWindow is string
        )
        && (
          !("preferencesChoreAdvancedOptionsOpenV2" in request.resource.data)
          || request.resource.data.preferencesChoreAdvancedOptionsOpenV2 is bool
        )
        && (
          !("preferencesThemeOptionId" in request.resource.data)
          || request.resource.data.preferencesThemeOptionId is string
        )
        && (
          !("preferencesThemePrimaryColor" in request.resource.data)
          || request.resource.data.preferencesThemePrimaryColor is string
        )
        && (
          !("preferencesThemeSecondaryColor" in request.resource.data)
          || request.resource.data.preferencesThemeSecondaryColor is string
        )
        && (
          !("preferencesThemeTertiaryColor" in request.resource.data)
          || request.resource.data.preferencesThemeTertiaryColor is string
        )
        && (
          !("preferencesUpdatedAt" in request.resource.data)
          || request.resource.data.preferencesUpdatedAt is timestamp
        )
        && (
          !("storeUpdatedAt" in request.resource.data)
          || request.resource.data.storeUpdatedAt is timestamp
        );
    }

    function isValidSelfUserStoreUpdate(uid) {
      return isSelf(uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "ownedStoreOptionIds",
          "selectedConfettiOptionId",
          "storeUpdatedAt"
        ])
        && (
          !("ownedStoreOptionIds" in request.resource.data)
          || request.resource.data.ownedStoreOptionIds is list
        )
        && (
          !("selectedConfettiOptionId" in request.resource.data)
          || request.resource.data.selectedConfettiOptionId is string
        )
        && (
          !("storeUpdatedAt" in request.resource.data)
          || request.resource.data.storeUpdatedAt is timestamp
        );
    }

    function isValidSelfUserWalletUpdate(uid) {
      return isSelf(uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "walletBalance",
          "walletUpdatedAt"
        ])
        && request.resource.data.walletBalance is int
        && request.resource.data.walletBalance >= 0
        && request.resource.data.walletUpdatedAt is timestamp;
    }

    function isValidSelfUserGoogleTasksUpdate(uid) {
      return isSelf(uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "googleTasksLinked",
          "googleTasksRefreshToken",
          "googleTasksAccessToken",
          "googleTasksAccessTokenExpiresAt",
          "googleTasksScope",
          "googleTasksLinkedAt",
          "googleTasksSelectedTaskListIds",
          "googleTasksSelectedTaskListTitles",
          "googleTasksSelectedTaskListId",
          "googleTasksSelectedTaskListTitle",
          "googleTasksLastSyncStatus",
          "googleTasksLastSyncError",
          "googleTasksLastSyncedAt",
          "googleTasksUpdatedAt"
        ])
        && (
          !("googleTasksLinked" in request.resource.data)
          || request.resource.data.googleTasksLinked is bool
        )
        && (
          !("googleTasksRefreshToken" in request.resource.data)
          || request.resource.data.googleTasksRefreshToken is string
        )
        && (
          !("googleTasksAccessToken" in request.resource.data)
          || request.resource.data.googleTasksAccessToken is string
        )
        && (
          !("googleTasksAccessTokenExpiresAt" in request.resource.data)
          || request.resource.data.googleTasksAccessTokenExpiresAt is string
          || request.resource.data.googleTasksAccessTokenExpiresAt is timestamp
        )
        && (
          !("googleTasksScope" in request.resource.data)
          || request.resource.data.googleTasksScope is string
        )
        && (
          !("googleTasksLinkedAt" in request.resource.data)
          || request.resource.data.googleTasksLinkedAt is timestamp
        )
        && (
          !("googleTasksSelectedTaskListIds" in request.resource.data)
          || request.resource.data.googleTasksSelectedTaskListIds is list
        )
        && (
          !("googleTasksSelectedTaskListTitles" in request.resource.data)
          || request.resource.data.googleTasksSelectedTaskListTitles is list
        )
        && (
          !("googleTasksSelectedTaskListId" in request.resource.data)
          || request.resource.data.googleTasksSelectedTaskListId is string
        )
        && (
          !("googleTasksSelectedTaskListTitle" in request.resource.data)
          || request.resource.data.googleTasksSelectedTaskListTitle is string
        )
        && (
          !("googleTasksLastSyncStatus" in request.resource.data)
          || request.resource.data.googleTasksLastSyncStatus is string
        )
        && (
          !("googleTasksLastSyncError" in request.resource.data)
          || request.resource.data.googleTasksLastSyncError is string
        )
        && (
          !("googleTasksLastSyncedAt" in request.resource.data)
          || request.resource.data.googleTasksLastSyncedAt is timestamp
        )
        && (
          !("googleTasksUpdatedAt" in request.resource.data)
          || request.resource.data.googleTasksUpdatedAt is timestamp
        );
    }

    function isValidSelfUserUpdate(uid) {
      return isValidSelfUserProfileUpdate(uid)
        || isValidSelfUserPreferencesUpdate(uid)
        || isValidSelfUserStoreUpdate(uid)
        || isValidSelfUserWalletUpdate(uid)
        || isValidSelfUserGoogleTasksUpdate(uid)
        || (
          isSelf(uid)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "uid",
            "role",
            "email",
            "displayName",
            "photoUrl",
            "provider",
            "lastSignInAt",
            "familyIds",
            "lastFamilyUpdateAt"
          ])
          && isValidSelfUserAuthSync(uid)
        );
    }

    function isWalletLedgerAmountShapeValid() {
      return request.resource.data.delta is int
        && request.resource.data.balanceAfter is int
        && request.resource.data.entryType is string
        && request.resource.data.creditAmount is int
        && request.resource.data.debitAmount is int
        && request.resource.data.countsTowardBalance == true
        && (
          (
            request.resource.data.delta > 0
            && request.resource.data.entryType == "credit"
            && request.resource.data.creditAmount == request.resource.data.delta
            && request.resource.data.debitAmount == 0
          )
          || (
            request.resource.data.delta < 0
            && request.resource.data.entryType == "debit"
            && request.resource.data.creditAmount == 0
            && request.resource.data.debitAmount == (0 - request.resource.data.delta)
          )
        );
    }

    function isWalletLedgerCreateBaseValid(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      return request.resource.data.uid == uid
        && request.resource.data.reason is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.choreId is string
        && request.resource.data.itemId is string
        && isWalletLedgerAmountShapeValid()
        && request.resource.data.balanceAfter == getAfter(userPath).data.walletBalance;
    }

    function userPrimaryFamilyHasChore(uid, choreId) {
      let familyId = primaryFamilyIdForUser(uid);
      return familyId is string
        && familyId != ""
        && exists(/databases/$(database)/documents/families/$(familyId)/chores/$(choreId));
    }

    function userPrimaryFamilyChore(uid, choreId) {
      return get(/databases/$(database)/documents/families/$(primaryFamilyIdForUser(uid))/chores/$(choreId)).data;
    }

    function isValidChoreCompleteLedgerCreate(uid, actorIsAdmin) {
      return request.resource.data.reason == "chore_complete"
        && request.resource.data.choreId != ""
        && request.resource.data.itemId == ""
        && request.resource.data.delta > 0
        && request.resource.data.balanceAfter >= request.resource.data.delta
        && entryId == "chore_complete_" + request.resource.data.choreId
        && userPrimaryFamilyHasChore(uid, request.resource.data.choreId)
        && userPrimaryFamilyChore(uid, request.resource.data.choreId).deleted != true
        && request.resource.data.delta > 0
        && userPrimaryFamilyChore(uid, request.resource.data.choreId).status in ["Submitted", "Approved"]
        && (
          actorIsAdmin
          || isRequesterAssigneeId(userPrimaryFamilyChore(uid, request.resource.data.choreId).assigneeId)
        );
    }

    function isValidChoreUndoLedgerCreate(uid, actorIsAdmin) {
      return request.resource.data.reason == "chore_undo_complete"
        && request.resource.data.choreId != ""
        && request.resource.data.itemId == ""
        && request.resource.data.delta < 0
        && entryId == "chore_undo_complete_" + request.resource.data.choreId
        && userPrimaryFamilyHasChore(uid, request.resource.data.choreId)
        && userPrimaryFamilyChore(uid, request.resource.data.choreId).deleted != true
        && request.resource.data.delta < 0
        && userPrimaryFamilyChore(uid, request.resource.data.choreId).status in ["Open", "Deleted"]
        && (
          actorIsAdmin
          || isRequesterAssigneeId(userPrimaryFamilyChore(uid, request.resource.data.choreId).assigneeId)
        );
    }

    function isValidStorePurchaseLedgerCreate(uid) {
      return request.resource.data.reason == "store_purchase"
        && request.resource.data.itemId != ""
        && request.resource.data.choreId == ""
        && request.resource.data.delta < 0;
    }

    function isValidQuestRewardLedgerCreate(uid) {
      return request.resource.data.reason == "quest_reward"
        && request.resource.data.itemId is string
        && request.resource.data.choreId == ""
        && request.resource.data.delta > 0;
    }

    function canSelfCreateWalletLedger(uid) {
      return isSelf(uid)
        && isWalletLedgerCreateBaseValid(uid)
        && (
          isValidChoreCompleteLedgerCreate(uid, false)
          || isValidChoreUndoLedgerCreate(uid, false)
          || isValidStorePurchaseLedgerCreate(uid)
          || isValidQuestRewardLedgerCreate(uid)
        );
    }

    function canAdminCreateWalletLedger(uid) {
      return canAdminManageUser(uid)
        && isWalletLedgerCreateBaseValid(uid)
        && (
          request.resource.data.reason == "manual_adjustment"
          || isValidChoreCompleteLedgerCreate(uid, true)
          || isValidChoreUndoLedgerCreate(uid, true)
          || isValidStorePurchaseLedgerCreate(uid)
          || isValidQuestRewardLedgerCreate(uid)
        );
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || canAdminManageUser(uid) || canAdminBootstrapManagedUser(uid);
      allow create: if isValidSelfUserCreate(uid)
        || (canAdminBootstrapManagedUser(uid)
          && request.resource.data.uid == uid
          && request.resource.data.familyIds is list
          && request.resource.data.familyIds.hasAny([primaryFamilyIdForUser(request.auth.uid)]));
      allow update: if isValidSelfUserUpdate(uid) || canAdminManageUser(uid);
      allow delete: if false;

      match /walletLedger/{entryId} {
        allow read: if isSelf(uid) || canAdminManageUser(uid);
        allow create: if canSelfCreateWalletLedger(uid) || canAdminCreateWalletLedger(uid);
        allow update, delete: if false;
      }

      match /inventory/{itemId} {
        allow read: if isSelf(uid) || canAdminManageUser(uid);
        allow create, update: if (isSelf(uid) || canAdminManageUser(uid))
          && request.resource.data.itemId == itemId
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 0
          && request.resource.data.totalAcquired is int
          && request.resource.data.totalAcquired >= 0
          && request.resource.data.totalConsumed is int
          && request.resource.data.totalConsumed >= 0
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }

      match /questProgress/{questId} {
        allow read: if isSelf(uid) || canAdminManageUser(uid);
        allow create, update: if (isSelf(uid) || canAdminManageUser(uid))
          && request.resource.data.userId == uid
          && request.resource.data.questId == questId
          && request.resource.data.currentNodeId is string
          && request.resource.data.status is string
          && request.resource.data.status in ["not_started", "in_progress", "completed"]
          && request.resource.data.choicesMade is list
          && request.resource.data.endingsReached is list
          && request.resource.data.bestEndingId is string
          && request.resource.data.timesPlayed is int
          && request.resource.data.timesPlayed >= 0
          && (request.resource.data.completedAt is timestamp || request.resource.data.completedAt is string)
          && (request.resource.data.lastPlayedAt is timestamp || request.resource.data.lastPlayedAt is string)
          && (request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt is string)
          && (
            request.resource.data.firstCompletionRewardGrantedAt is timestamp
            || request.resource.data.firstCompletionRewardGrantedAt is string
          )
          && (
            request.resource.data.allEndingsRewardGrantedAt is timestamp
            || request.resource.data.allEndingsRewardGrantedAt is string
          )
          && request.resource.data.endingRewardIdsGranted is list;
        allow delete: if false;
      }

      match /achievements/{achievementId} {
        allow read: if isSelf(uid) || canAdminManageUser(uid);
        allow create, update: if isSelf(uid) || canAdminManageUser(uid);
        allow delete: if false;
      }

      match /achievementState/{stateId} {
        allow read: if isSelf(uid) || canAdminManageUser(uid);
        allow create, update: if isSelf(uid) || canAdminManageUser(uid);
        allow delete: if false;
      }
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isFamilyAdmin(familyId);

      match /members/{memberId} {
        allow read: if isFamilyMember(familyId);

        // Admins can add members.
        // Bootstrap exception: family creator can create their own initial admin member doc.
        allow create: if isFamilyAdmin(familyId)
          || (
            isSelf(memberId)
            && isFamilyCreatorBootstrap(familyId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == "admin"
            && request.resource.data.status == "active"
          )
          || (
            isSelf(memberId)
            && hasClaimableEmailInvite(familyId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email.lower() == request.auth.token.email.lower()
            && inviteRoleAllowsClaim(familyId)
            && request.resource.data.status == "active"
          )
          || (
            isSelf(memberId)
            && hasClaimableUidInvite(familyId)
            && request.resource.data.uid == request.auth.uid
            && uidInviteEmailAllowsClaim(familyId)
            && uidInviteRoleAllowsClaim(familyId)
            && request.resource.data.status == "active"
          );

        allow update: if isFamilyAdmin(familyId)
          || (
            isSelf(memberId)
            && hasClaimableEmailInvite(familyId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email.lower() == request.auth.token.email.lower()
            && inviteRoleAllowsClaim(familyId)
            && request.resource.data.status == "active"
          )
          || (
            isSelf(memberId)
            && hasClaimableUidInvite(familyId)
            && request.resource.data.uid == request.auth.uid
            && uidInviteEmailAllowsClaim(familyId)
            && uidInviteRoleAllowsClaim(familyId)
            && request.resource.data.status == "active"
          )
          || (
            isSelf(memberId)
            && hasUidMemberDoc(familyId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "dashboardPrimaryColor",
              "avatarId",
              "avatarPhotoUrl",
              "selectedConfettiOptionId",
              "pushNotifyChoreCompleted",
              "pushNotifyRewardClaimed",
              "pushNotifyChoreApprovalRequired",
              "pushNotificationPermission",
              "pushNotificationsUpdatedAt",
              "updatedAt",
              "lastSignInAt"
            ])
          );

        allow delete: if isFamilyAdmin(familyId);
      }

      match /chores/{choreId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyAdmin(familyId)
          || (
            isFamilyMember(familyId)
            && request.resource.data.source == "google_tasks"
            && request.resource.data.googleTaskOwnerUid == request.auth.uid
            && isRequesterAssigneeId(request.resource.data.assigneeId)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.coinValue is int
            && request.resource.data.coinValue == 0
            && request.resource.data.status in ["Open", "Submitted", "Approved", "Rejected", "Deleted"]
            && request.resource.data.deleted is bool
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.googleTaskId is string
            && request.resource.data.googleTaskListId is string
            && request.resource.data.assigneeName is string
            && request.resource.data.title is string
          )
          || canPlayerCreateRecurringSuccessor(familyId);
        allow delete: if isFamilyAdmin(familyId);
        allow update: if isFamilyAdmin(familyId)
          || (
            isFamilyMember(familyId)
            && canRequesterCompleteChore(familyId, resource.data)
            && resource.data.status == "Open"
            && request.resource.data.status in ["Submitted", "Approved"]
            && (
              (request.resource.data.status == "Submitted" && resource.data.requireApproval == true)
              || (request.resource.data.status == "Approved" && resource.data.requireApproval != true)
            )
            && request.resource.data.submittedAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && (
              !("spawnedNextChoreId" in request.resource.data)
              || request.resource.data.spawnedNextChoreId is string
            )
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "status",
              "submittedAt",
              "updatedAt",
              "spawnedNextChoreId"
            ])
          )
          || (
            isFamilyMember(familyId)
            && resource.data.source == "google_tasks"
            && resource.data.googleTaskOwnerUid == request.auth.uid
            && request.resource.data.source == "google_tasks"
            && request.resource.data.googleTaskOwnerUid == request.auth.uid
            && isRequesterAssigneeId(resource.data.assigneeId)
            && isRequesterAssigneeId(request.resource.data.assigneeId)
            && resource.data.coinValue is int
            && request.resource.data.coinValue is int
            && resource.data.coinValue == 0
            && request.resource.data.coinValue == 0
            && request.resource.data.status in ["Open", "Submitted", "Approved", "Rejected", "Deleted"]
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "title",
              "details",
              "dueDate",
              "status",
              "submittedAt",
              "updatedAt",
              "deleted",
              "deletedAt",
              "assigneeId",
              "assigneeName",
              "googleTaskId"
            ])
          );
      }

      match /categories/{categoryId} {
        allow read: if isFamilyMember(familyId);
        allow create, update, delete: if isFamilyAdmin(familyId);
      }

      match /rewards/{rewardId} {
        allow read: if isFamilyMember(familyId);
        allow create, delete: if isFamilyAdmin(familyId);
        allow update: if isFamilyAdmin(familyId) || canRedeemFamilyReward(familyId);
      }

      match /notifications/{notificationId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.familyId == familyId
          && (
            request.resource.data.actorUid == request.auth.uid
            || (
              isFamilyAdmin(familyId)
              && request.resource.data.actorUid is string
              && userBelongsToFamily(request.resource.data.actorUid, familyId)
            )
          )
          && request.resource.data.createdAt is timestamp
          && request.resource.data.relatedIds is list;
        allow update, delete: if false;
      }

      match /notificationSeen/{seenId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.notificationId is string
          && request.resource.data.seenAt is timestamp;
        allow update: if isFamilyMember(familyId)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.notificationId == resource.data.notificationId
          && request.resource.data.seenAt is timestamp;
        allow delete: if isFamilyMember(familyId) && resource.data.uid == request.auth.uid;
      }

      match /pushSubscriptions/{subscriptionId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyAdmin(familyId)
          && request.resource.data.familyId == familyId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.subscriptionCiphertext is string
          && request.resource.data.endpointHash is string
          && request.resource.data.permission is string
          && request.resource.data.pushNotifyChoreCompleted is bool
          && request.resource.data.pushNotifyRewardClaimed is bool
          && request.resource.data.pushNotifyChoreApprovalRequired is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if isFamilyAdmin(familyId)
          && resource.data.uid == request.auth.uid
          && request.resource.data.familyId == familyId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.subscriptionCiphertext is string
          && request.resource.data.endpointHash is string
          && request.resource.data.permission is string
          && request.resource.data.pushNotifyChoreCompleted is bool
          && request.resource.data.pushNotifyRewardClaimed is bool
          && request.resource.data.pushNotifyChoreApprovalRequired is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isFamilyAdmin(familyId) && resource.data.uid == request.auth.uid;
      }

      match /choreUsage/{usageId} {
        allow read: if isFamilyMember(familyId);
        allow create, update, delete: if isFamilyAdmin(familyId);
      }

      match /awardClaims/{claimId} {
        allow read: if isFamilyMember(familyId);
        allow create: if canCreateAwardClaim(familyId);
        allow update: if canAdminClaimAward(familyId);
        allow delete: if false;
      }

      match /achievementEvents/{eventId} {
        allow read: if isFamilyAdmin(familyId);
        allow create, update: if isFamilyMember(familyId);
        allow delete: if false;
      }
    }

    match /inviteLookup/{email} {
      allow read: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;

      allow create, update: if isSignedIn()
        && request.resource.data.familyId is string
        && isFamilyAdmin(request.resource.data.familyId);

      allow delete: if isSignedIn()
        && resource.data.familyId is string
        && isFamilyAdmin(resource.data.familyId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

