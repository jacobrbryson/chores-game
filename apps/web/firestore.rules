rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function primaryFamilyIdForUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.familyIds[0];
    }

    function userBelongsToFamily(uid, familyId) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.familyIds is list
        && get(/databases/$(database)/documents/users/$(uid)).data.familyIds.hasAny([familyId]);
    }

    function canAdminManageUser(uid) {
      let requesterFamilyId = primaryFamilyIdForUser(request.auth.uid);
      return isSignedIn()
        && requesterFamilyId is string
        && requesterFamilyId != ""
        && isFamilyAdmin(requesterFamilyId)
        && userBelongsToFamily(uid, requesterFamilyId);
    }

    function canAdminBootstrapManagedUser(uid) {
      let requesterFamilyId = primaryFamilyIdForUser(request.auth.uid);
      return isSignedIn()
        && requesterFamilyId is string
        && requesterFamilyId != ""
        && isFamilyAdmin(requesterFamilyId)
        && exists(/databases/$(database)/documents/families/$(requesterFamilyId)/members/$(uid))
        && get(/databases/$(database)/documents/families/$(requesterFamilyId)/members/$(uid)).data.deleted != true
        && (
          get(/databases/$(database)/documents/families/$(requesterFamilyId)/members/$(uid)).data.role == null
          || get(/databases/$(database)/documents/families/$(requesterFamilyId)/members/$(uid)).data.role == "player"
        );
    }

    function memberDocPathByUid(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
    }

    function memberDocPathByEmail(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.token.email.lower());
    }

    function hasUidMemberDoc(familyId) {
      return isSignedIn()
        && exists(memberDocPathByUid(familyId))
        && get(memberDocPathByUid(familyId)).data.deleted != true;
    }

    function hasEmailMemberDoc(familyId) {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email != ""
        && exists(memberDocPathByEmail(familyId))
        && get(memberDocPathByEmail(familyId)).data.deleted != true;
    }

    function hasClaimableEmailInvite(familyId) {
      return hasEmailMemberDoc(familyId)
        && (
          get(memberDocPathByEmail(familyId)).data.status == "invited"
          || get(memberDocPathByEmail(familyId)).data.status == "claimed"
        );
    }

    function hasClaimableUidInvite(familyId) {
      return hasUidMemberDoc(familyId)
        && (
          get(memberDocPathByUid(familyId)).data.status == "invited"
          || get(memberDocPathByUid(familyId)).data.status == "claimed"
        );
    }

    function inviteRoleAllowsClaim(familyId) {
      return get(memberDocPathByEmail(familyId)).data.role == null
        ? request.resource.data.role == "player"
        : request.resource.data.role == get(memberDocPathByEmail(familyId)).data.role;
    }

    function uidInviteRoleAllowsClaim(familyId) {
      return get(memberDocPathByUid(familyId)).data.role == null
        ? request.resource.data.role == "player"
        : request.resource.data.role == get(memberDocPathByUid(familyId)).data.role;
    }

    function uidInviteEmailAllowsClaim(familyId) {
      return get(memberDocPathByUid(familyId)).data.email == null
        || (
          request.resource.data.email is string
          && request.resource.data.email.lower() == get(memberDocPathByUid(familyId)).data.email.lower()
        );
    }

    function isFamilyMember(familyId) {
      return hasUidMemberDoc(familyId) || hasEmailMemberDoc(familyId);
    }

    function isRequesterAssigneeId(assigneeId) {
      return isSignedIn()
        && (
          assigneeId == request.auth.uid
          || (
            request.auth.token.email != null
            && request.auth.token.email != ""
            && assigneeId == request.auth.token.email.lower()
          )
        );
    }

    function isFamilyAdmin(familyId) {
      return hasUidMemberDoc(familyId)
        && get(memberDocPathByUid(familyId)).data.role == "admin";
    }

    function isFamilyCreatorBootstrap(familyId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/families/$(familyId)).data.createdBy == request.auth.uid;
    }

    function rewardRedeemedCount(data) {
      return data.familyRedeemedCount is int ? data.familyRedeemedCount : 0;
    }

    function canRedeemFamilyReward(familyId) {
      return isFamilyMember(familyId)
        && resource.data.deleted != true
        && resource.data.disabled != true
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["familyRedeemedCount", "updatedAt"])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.familyRedeemedCount is int
        && request.resource.data.familyRedeemedCount == rewardRedeemedCount(resource.data) + 1;
    }

    function canCreateAwardClaim(familyId) {
      return isFamilyMember(familyId)
        && request.resource.data.rewardId is string
        && request.resource.data.rewardDescription is string
        && request.resource.data.rewardImageId is string
        && request.resource.data.coinCost is int
        && request.resource.data.purchaserUid == request.auth.uid
        && request.resource.data.purchaserName is string
        && request.resource.data.purchaserEmail is string
        && request.resource.data.status == "unclaimed"
        && request.resource.data.purchasedAt is timestamp
        && request.resource.data.claimedByUid is string
        && request.resource.data.claimedByName is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function canAdminClaimAward(familyId) {
      return isFamilyAdmin(familyId)
        && resource.data.status == "unclaimed"
        && request.resource.data.status == "claimed"
        && request.resource.data.claimedAt is timestamp
        && request.resource.data.claimedByUid == request.auth.uid
        && request.resource.data.claimedByName is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "status",
          "claimedAt",
          "claimedByUid",
          "claimedByName",
          "updatedAt"
        ]);
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || canAdminManageUser(uid) || canAdminBootstrapManagedUser(uid);
      allow create: if (isSelf(uid) && request.resource.data.uid == request.auth.uid)
        || (canAdminBootstrapManagedUser(uid)
          && request.resource.data.uid == uid
          && request.resource.data.familyIds is list
          && request.resource.data.familyIds.hasAny([primaryFamilyIdForUser(request.auth.uid)]));
      allow update: if isSelf(uid) || canAdminManageUser(uid);
      allow delete: if isSelf(uid);

      match /walletLedger/{entryId} {
        allow read: if isSelf(uid);
        allow create: if (isSelf(uid) || canAdminManageUser(uid))
          && request.resource.data.uid == uid
          && request.resource.data.reason is string
          && request.resource.data.delta is int
          && request.resource.data.balanceAfter is int
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isFamilyAdmin(familyId);

      match /members/{memberId} {
        allow read: if isFamilyMember(familyId);

        // Admins can add members.
        // Bootstrap exception: family creator can create their own initial admin member doc.
        allow create: if isFamilyAdmin(familyId)
          || (
            isSelf(memberId)
            && isFamilyCreatorBootstrap(familyId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == "admin"
            && request.resource.data.status == "active"
          )
          || (
            isSelf(memberId)
            && hasClaimableEmailInvite(familyId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email.lower() == request.auth.token.email.lower()
            && inviteRoleAllowsClaim(familyId)
            && request.resource.data.status == "active"
          )
          || (
            isSelf(memberId)
            && hasClaimableUidInvite(familyId)
            && request.resource.data.uid == request.auth.uid
            && uidInviteEmailAllowsClaim(familyId)
            && uidInviteRoleAllowsClaim(familyId)
            && request.resource.data.status == "active"
          );

        allow update: if isFamilyAdmin(familyId)
          || (
            isSelf(memberId)
            && hasClaimableEmailInvite(familyId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email.lower() == request.auth.token.email.lower()
            && inviteRoleAllowsClaim(familyId)
            && request.resource.data.status == "active"
          )
          || (
            isSelf(memberId)
            && hasClaimableUidInvite(familyId)
            && request.resource.data.uid == request.auth.uid
            && uidInviteEmailAllowsClaim(familyId)
            && uidInviteRoleAllowsClaim(familyId)
            && request.resource.data.status == "active"
          )
          || (
            isSelf(memberId)
            && hasUidMemberDoc(familyId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "dashboardPrimaryColor",
              "avatarId",
              "avatarPhotoUrl",
              "selectedConfettiOptionId",
              "updatedAt",
              "lastSignInAt"
            ])
          );

        allow delete: if isFamilyAdmin(familyId);
      }

      match /chores/{choreId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyAdmin(familyId)
          || (
            isFamilyMember(familyId)
            && request.resource.data.source == "google_tasks"
            && request.resource.data.googleTaskOwnerUid == request.auth.uid
            && isRequesterAssigneeId(request.resource.data.assigneeId)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.coinValue is int
            && request.resource.data.coinValue == 0
            && request.resource.data.status in ["Open", "Submitted", "Approved", "Rejected", "Deleted"]
            && request.resource.data.deleted is bool
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.googleTaskId is string
            && request.resource.data.googleTaskListId is string
            && request.resource.data.assigneeName is string
            && request.resource.data.title is string
          );
        allow delete: if isFamilyAdmin(familyId);
        allow update: if isFamilyAdmin(familyId)
          || (
            isFamilyMember(familyId)
            && isRequesterAssigneeId(resource.data.assigneeId)
            && resource.data.status == "Open"
            && request.resource.data.status == "Submitted"
            && request.resource.data.submittedAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "submittedAt", "updatedAt"])
          )
          || (
            isFamilyMember(familyId)
            && resource.data.source == "google_tasks"
            && resource.data.googleTaskOwnerUid == request.auth.uid
            && request.resource.data.source == "google_tasks"
            && request.resource.data.googleTaskOwnerUid == request.auth.uid
            && isRequesterAssigneeId(resource.data.assigneeId)
            && isRequesterAssigneeId(request.resource.data.assigneeId)
            && resource.data.coinValue is int
            && request.resource.data.coinValue is int
            && resource.data.coinValue == 0
            && request.resource.data.coinValue == 0
            && request.resource.data.status in ["Open", "Submitted", "Approved", "Rejected", "Deleted"]
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "title",
              "details",
              "dueDate",
              "status",
              "submittedAt",
              "updatedAt",
              "deleted",
              "deletedAt",
              "assigneeId",
              "assigneeName",
              "googleTaskId"
            ])
          );
      }

      match /categories/{categoryId} {
        allow read: if isFamilyMember(familyId);
        allow create, update, delete: if isFamilyAdmin(familyId);
      }

      match /rewards/{rewardId} {
        allow read: if isFamilyMember(familyId);
        allow create, delete: if isFamilyAdmin(familyId);
        allow update: if isFamilyAdmin(familyId) || canRedeemFamilyReward(familyId);
      }

      match /notifications/{notificationId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.familyId == familyId
          && (
            request.resource.data.actorUid == request.auth.uid
            || (
              isFamilyAdmin(familyId)
              && request.resource.data.actorUid is string
              && userBelongsToFamily(request.resource.data.actorUid, familyId)
            )
          )
          && request.resource.data.createdAt is timestamp
          && request.resource.data.relatedIds is list;
        allow update, delete: if false;
      }

      match /notificationSeen/{seenId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.notificationId is string
          && request.resource.data.seenAt is timestamp;
        allow update: if isFamilyMember(familyId)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.notificationId == resource.data.notificationId
          && request.resource.data.seenAt is timestamp;
        allow delete: if isFamilyMember(familyId) && resource.data.uid == request.auth.uid;
      }

      match /choreUsage/{usageId} {
        allow read: if isFamilyMember(familyId);
        allow create, update, delete: if isFamilyAdmin(familyId);
      }

      match /awardClaims/{claimId} {
        allow read: if isFamilyMember(familyId);
        allow create: if canCreateAwardClaim(familyId);
        allow update: if canAdminClaimAward(familyId);
        allow delete: if false;
      }
    }

    match /inviteLookup/{email} {
      allow read: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;

      allow create, update: if isSignedIn()
        && request.resource.data.familyId is string
        && isFamilyAdmin(request.resource.data.familyId);

      allow delete: if isSignedIn()
        && resource.data.familyId is string
        && isFamilyAdmin(resource.data.familyId);
    }

    match /choreUsageGlobal/{usageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

