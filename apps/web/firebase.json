{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "apphosting": {
    "backendId": "api-chores-game",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".next",
      ".git",
      "public",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  }
}
