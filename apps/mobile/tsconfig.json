{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@packages/core": [
        "../../packages/core/src/index.ts"
      ],
      "@packages/core/*": [
        "../../packages/core/*"
      ],
      "@packages/locales": [
        "../../packages/locales/src/index.ts"
      ],
      "@packages/locales/*": [
        "../../packages/locales/src/*"
      ],
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
