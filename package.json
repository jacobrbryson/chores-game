{
  "name": "chores-game",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present --parallel",
    "dev:web": "npm run dev -w @apps/web",
    "dev:mobile": "npm run dev -w @apps/mobile",
    "dev:ws": "npm run dev -w @apps/ws",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:seed": "node scripts/test-data/seed-e2e.mjs",
    "support:family-activity-metrics": "node scripts/rebuild-support-family-activity-metrics.mjs",
    "migration:email-keying-dry-run": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./scripts/lib/ts-alias-register.mjs scripts/email-keying-dry-run.ts",
    "migration:cleanup-invite-lookups": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./scripts/lib/ts-alias-register.mjs scripts/cleanup-orphaned-invite-lookups.ts",
    "migration:rewrite-chore-assignees": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./scripts/lib/ts-alias-register.mjs scripts/rewrite-email-chore-assignees.ts",
    "migration:backfill-chore-fields": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./scripts/lib/ts-alias-register.mjs scripts/backfill-chore-fields.ts",
    "migration:delete-orphaned-family": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./scripts/lib/ts-alias-register.mjs scripts/delete-orphaned-family.ts",
    "migration:expire-pending-invites": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./scripts/lib/ts-alias-register.mjs scripts/expire-pending-email-invites.ts",
    "deploy:web": "node scripts/deploy-web.mjs",
    "wallet:rebuild": "node scripts/rebuild-wallet-balances.mjs",
    "admin:grant-confetti": "node scripts/admin/grant-all-confetti-options.mjs",
    "android": "npm run android -w @apps/mobile",
    "ios": "npm run ios -w @apps/mobile"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "version": "1.0.0",
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
